# Copy to `.env` and adjust. Every variable is optional.

# Address and port the UI is published on. Keep 127.0.0.1 unless you add network
# authentication or a reverse proxy: the default auth strategy has no password.
OPENFOX_BIND=127.0.0.1
OPENFOX_PUBLISH_PORT=10369

# The uid/gid the server runs as, so files it creates in your projects belong to
# you. Linux: `id -u` / `id -g`. macOS (Docker Desktop): 501 / 20.
OPENFOX_UID=1000
OPENFOX_GID=1000

# Host folder mounted at /projects, where new projects are created by default.
OPENFOX_PROJECTS_DIR=./projects

# Ports forwarded to the Docker host, so an AI provider running there and
# configured as http://localhost:<port> works unchanged (LM Studio 1234,
# Ollama 11434, vLLM 8000, llama.cpp 8080). Empty string disables forwarding.
OPENFOX_HOST_PORTS=1234,11434,8000,8080

# Memory. The heap value is a ceiling the server may grow to, not a reservation.
# Raise both on a machine with plenty of RAM (e.g. 8192 and 10g on a 48 GB host).
OPENFOX_HEAP_MB=3072
OPENFOX_MEM_LIMIT=4g

# Image tag.
OPENFOX_TAG=local

# Web search without an API key: a private SearXNG next to OpenFox (docs/DOCKER.md).
# COMPOSE_PROFILES=search
# OPENFOX_SEARCH=searxng
